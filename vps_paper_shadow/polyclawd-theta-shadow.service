[Unit]
Description=Polyclawd theta-inversion paper-shadow runner (one-shot)
After=network-online.target

[Service]
Type=oneshot
User=linuxuser
WorkingDirectory=/var/www/virtuosocrypto.com/polyclawd
ExecStart=/var/www/virtuosocrypto.com/polyclawd/venv/bin/python /var/www/virtuosocrypto.com/polyclawd/vps_paper_shadow/shadow_runner.py --db /var/www/virtuosocrypto.com/polyclawd/storage/shadow_trades.db --source mispriced_category --limit 2000

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/virtuosocrypto.com/polyclawd/storage
PrivateTmp=true
