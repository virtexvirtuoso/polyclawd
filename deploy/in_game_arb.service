# /etc/systemd/system/polyclawd-ingame-arb.service
# In-game cross-venue arb watcher: Polymarket-US <-> Kalshi, ALERT-ONLY.
# Sweeps live NFL games every 45s, pairs identical markets, Telegram-alerts
# two-leg combos netting >=2c after Kalshi taker fees. Never places orders.
# Zero trading blast radius: stop = `systemctl stop polyclawd-ingame-arb`.
# Status: journalctl -u polyclawd-ingame-arb -f ; sqlite3 storage/in_game_arb.db
# Git stamp: install the same drop-in as polyclawd-ws (git-stamp.conf).
[Unit]
Description=Polyclawd In-Game Arb Watcher (PM-US <-> Kalshi, alert-only)
After=network.target

[Service]
Type=simple
User=linuxuser
Group=linuxuser
WorkingDirectory=/var/www/virtuosocrypto.com/polyclawd
EnvironmentFile=/etc/default/polyclawd
Environment=PYTHONUNBUFFERED=1
Environment=POLY_ARB_DB=/var/www/virtuosocrypto.com/polyclawd/storage/in_game_arb.db
ExecStart=/var/www/virtuosocrypto.com/polyclawd/venv/bin/python3 -m services.in_game_arb
Restart=always
RestartSec=10
TimeoutStopSec=30
# Alert-only service: cap memory so an OOM kills only this unit.
MemoryMax=300M
Nice=10

[Install]
WantedBy=multi-user.target